# AI Maestro — imagen de producción en modo headless.
#
# Distinta del `Containerfile` de la raíz, que es de desarrollo: aquel corre
# `yarn test`, deja el compilador dentro y monta el árbol completo. Esta sirve
# un único propósito: exponer la API de AMP para que los agentes se comuniquen,
# sin interfaz.
#
# Headless evita Next.js por completo (`MAESTRO_MODE=headless`), lo que baja el
# arranque de ~5 s a ~1 s y la memoria de ~300 MB a ~100 MB. Un contenedor que
# solo enruta mensajes no tiene por qué cargar el dashboard.

# --- Etapa de construcción -------------------------------------------------
# Las dependencias nativas (node-pty, cozo-node) necesitan compilador. Se queda
# en esta etapa: la imagen final no lleva build-essential ni python3, que son
# superficie de ataque y ~300 MB que nadie usa en ejecución.
FROM docker.io/library/node:20.19.2-bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# `scripts/` va antes que el install porque el postinstall de package.json
# ejecuta scripts/postinstall-node-pty.js: sin él yarn falla con "Cannot find
# module". Se copia solo esa carpeta, no el árbol entero, para no invalidar la
# caché de dependencias con cada cambio de código.
COPY package.json yarn.lock ./
COPY scripts ./scripts
RUN yarn install --frozen-lockfile --production=false && yarn cache clean

# Recompilar node-pty contra el Node de ESTA imagen, y comprobarlo.
#
# El prebuild que trae node-pty está enlazado contra libnode.so.127 (Node 22);
# cargarlo aquí falla con "cannot open shared object file". El postinstall del
# repo intenta recompilar, pero captura el error y sigue adelante a propósito
# ("the app can still run in headless/API mode") — solo que server.mjs importa
# node-pty incondicionalmente, así que el contenedor arranca y muere.
#
# El `node -e` de después convierte ese fallo silencioso en un build roto, que
# es donde debe verse.
# El binario viejo se borra primero: `node-gyp rebuild` puede darlo por bueno
# y salir en un segundo, dejando el prebuild de Node 22 en su sitio. Sin este
# `rm` el paso parece correcto y el contenedor muere al arrancar.
RUN rm -f node_modules/node-pty/build/Release/pty.node \
    && cd node_modules/node-pty \
    && npx --yes node-gyp rebuild \
    && cd /app \
    && ldd node_modules/node-pty/build/Release/pty.node | grep -q libnode \
       && { echo "pty.node sigue enlazado a libnode; rebuild no sirvio" >&2; exit 1; } \
       || true \
    && node -e "require('node-pty'); console.log('node-pty OK para', process.version)"

COPY . .

# Podar las dependencias de desarrollo DESPUES de compilar los modulos
# nativos: `npm prune` las borra en sitio sin tocar build/Release/pty.node,
# mientras que reinstalar con --production volveria a traer el prebuild
# incompatible.
#
# No es solo tamano: vitest viaja en la imagen y Trivy le encuentra un CVE
# CRITICAL. Una dependencia que nunca se ejecuta en produccion sigue contando
# como superficie de ataque mientras este en el disco.
# `glob` es una dependencia FANTASMA: services/headless-router.ts,
# config-service.ts, shared-state.ts y plugin-builder-service.ts la importan,
# pero no aparece en package.json ni como prod ni como dev. Funcionaba porque
# otro paquete la arrastraba, y la poda la destapo. Se instala explicitamente
# hasta que el repo la declare.
RUN npm install --no-save --legacy-peer-deps glob \
    && node -e "require('glob'); console.log('glob disponible')"

# La poda va DESPUES de instalar glob: al reves, npm install reintroduce el
# arbol de desarrollo entero —vitest incluido, con su CVE CRITICAL— y deja la
# poda sin efecto. Costo una vuelta de escaneo descubrirlo.
# --legacy-peer-deps porque el arbol tiene conflictos de peer dependencies
# que yarn tolera y npm no (@anthropic-ai/claude-agent-sdk pide un @anthropic-ai/sdk
# distinto del instalado). Sin la bandera, prune aborta con ERESOLVE sin llegar
# a borrar nada.
RUN npm prune --omit=dev --legacy-peer-deps \
    && node -e "require('node-pty'); console.log('node-pty sigue OK tras podar')"

# Fuera Next.js y su cadena de React.
#
# server.mjs lo importa de forma DINAMICA y solo en la rama de modo completo
# (`const next = (await import('next')).default`, linea 2629); headless entra
# por la rama de headless-router y nunca lo evalua. Dejarlo dentro solo aporta
# peso y superficie: es el paquete con la CVE CRITICAL mas grave que Trivy
# encontro (CVE-2026-75604 en 14.2.35).
#
# Si algun dia headless necesitara Next, este RUN romperia el arranque de
# forma inmediata y visible, no en silencio.
# `tar` arrastra una CVE CRITICAL sin parche en la rama 6.x y llega como
# dependencia de @mapbox/node-pre-gyp.
#
# node-pre-gyp NO se puede borrar: cozo-node lo requiere al arrancar, no solo
# al instalar —comprobado, el contenedor muere con "Cannot find module
# '@mapbox/node-pre-gyp'"—. Lo que si sobra es su `tar`, que solo se usa para
# descomprimir binarios durante la instalacion, ya hecha en esta etapa.
#
# Si algun dia node-pre-gyp lo necesitara en ejecucion, el arranque romperia de
# forma inmediata y visible, como paso al borrarlo entero.
RUN rm -rf node_modules/tar node_modules/@mapbox/node-pre-gyp/node_modules/tar
RUN rm -rf node_modules/next node_modules/react node_modules/react-dom \
           node_modules/.next node_modules/@next \
    && node -e "process.env.MAESTRO_MODE='headless'; console.log('sin next en la imagen')"

# --- Imagen final ----------------------------------------------------------
FROM docker.io/library/node:20.19.2-bookworm-slim

# tini como PID 1: sin él, Node recibe las señales directamente y los procesos
# hijos quedan huérfanos al parar el Pod, alargando el terminationGracePeriod
# hasta el SIGKILL.
# upgrade ademas de install: la base bookworm-slim trae libgnutls30 con CVEs
# CRITICAL ya corregidas en el repositorio de Debian. Sin el upgrade, la imagen
# nace con vulnerabilidades que el propio apt puede resolver.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/server.mjs ./server.mjs
COPY --from=builder --chown=node:node /app/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=node:node /app/next.config.js ./next.config.js
COPY --from=builder --chown=node:node /app/lib ./lib
COPY --from=builder --chown=node:node /app/services ./services
COPY --from=builder --chown=node:node /app/types ./types
COPY --from=builder --chown=node:node /app/app ./app

# server.mjs escribe en ./logs al arrancar. /app pertenece a root, así que el
# usuario `node` no puede crearlo y el proceso muere con EACCES en mkdir. Se
# crea aquí con el dueño correcto en vez de dar /app entero a node.
# /app/logs y el estado bajo $HOME se crean con el dueño correcto. Sin esto,
# la declaración VOLUME de más abajo los crea como root y el proceso muere con
# EACCES la primera vez que escribe: registrar un agente o fijar la
# organización fallan con "permission denied" que no apunta a la causa.
RUN mkdir -p /app/logs /home/node/.aimaestro /home/node/.agent-messaging \
    && chown -R node:node /app/logs /home/node

# npm sale de la imagen final. Los modulos ya estan instalados y npm solo
# aporta su propia copia de `tar`, que arrastra una CVE CRITICAL sin parche en
# la rama 6.x. Un contenedor que solo enruta mensajes no instala paquetes.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

USER node

ENV NODE_ENV=production \
    MAESTRO_MODE=headless \
    PORT=23000 \
    # Sin tmux ni sesiones en un contenedor: dejar las notificaciones activas
    # llena el log de errores por cada mensaje entregado.
    NOTIFICATIONS_ENABLED=false

EXPOSE 23000

# El estado de AMP (identidades, cola de relevo) cuelga de $HOME. En Kubernetes
# se apunta a un volumen persistente; aquí queda declarado para que un `docker
# run` sin volumen no escriba en la capa de la imagen sin avisar.
VOLUME ["/home/node/.aimaestro", "/home/node/.agent-messaging"]

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:23000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["yarn", "headless:prod"]
